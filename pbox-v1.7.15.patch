+// A HID report descriptor names a gamepad when its first Usage, under the Generic
+// Desktop page, is Joystick (4) or Game Pad (5). A keyboard (6), a mouse (2), a
+// keypad or anything else is not one: it must never be taken away from the system.
+bool hidDescriptorIsGamepad(const uint8_t* d, size_t len) {
+    uint32_t usagePage = 0;
+    for (size_t i = 0; i < len;) {
+        const uint8_t b = d[i];
+        if (b == 0xFE) {  // a long item: skip it
+            if (i + 1 >= len) break;
+            i += 3 + d[i + 1];
+            continue;
+        }
+        size_t size = b & 3;
+        if (size == 3) size = 4;
+        if (i + 1 + size > len) break;
+        const uint8_t type = (b >> 2) & 3, tag = b >> 4;
+        uint32_t value = 0;
+        for (size_t k = 0; k < size; ++k) value |= static_cast<uint32_t>(d[i + 1 + k]) << (8 * k);
+        if (type == 1 && tag == 0) usagePage = value;  // Global: Usage Page
+        if (type == 2 && tag == 0) return usagePage == 0x01 && (value == 0x04 || value == 0x05);  // Local: Usage
+        i += 1 + size;
+    }
+    return false;
+}
