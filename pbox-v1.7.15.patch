index 3bfe528..dea777f 100644
--- a/src/ui/brand.cpp
+++ b/src/ui/brand.cpp
@@ -7,6 +7,7 @@
 
 #include <cmath>
 #include <string>
+#include <unordered_map>
 #include <vector>
 
 namespace xc::ui {
@@ -26,6 +27,28 @@ const Image* localLogo() {
     return logo.w == 384 && logo.h == 384 ? &logo : nullptr;
 }
 
+// The PBOX emblem (assets/pbox_emblem.png, 512x512), drawn in a circle at any
+// size. The scaled copies are kept: the header asks for the same size on every redraw.
+const Image* emblemAt(int size) {
+    static Image emblem;
+    static bool attempted = false;
+    static std::unordered_map<int, Image> scaled;
+    if (!attempted) {
+        attempted = true;
+        std::string bytes;
+        if (platform::readFile(platform::assetDir() + "/pbox_emblem.png", bytes) && decodeImage(bytes, emblem)) {
+            if (emblem.w != 512 || emblem.h != 512) emblem = {};
+        }
+    }
+    if (emblem.w != 512 || size < 2) return nullptr;
+    auto it = scaled.find(size);
+    if (it == scaled.end()) {
+        if (scaled.size() > 24) scaled.clear();  // the splash's pulse asks for many sizes
+        it = scaled.emplace(size, coverResize(emblem, size, size)).first;
+    }
+    return &it->second;
+}
+
 // A quadratic Bezier stroke stamped with discs: thin in the middle, wide at
 // both ends, like a brush swoosh.
 void swoosh(Canvas& c, float x0, float y0, float cx, float cy, float x1, float y1, float thin, float wide,
@@ -44,6 +67,13 @@ void swoosh(Canvas& c, float x0, float y0, float cx, float cy, float x1, float y
 }  // namespace
 
 void drawBrandMark(Canvas& c, float cx, float cy, float r, Color color) {
+    // The supplied emblem, when it is packaged; its alpha (the splash's fade) is the colour's.
+    const int emblemSize = static_cast<int>(std::lround(r * 2));
+    if (const Image* e = emblemAt(emblemSize)) {
+        c.drawImage(*e, static_cast<int>(std::lround(cx - emblemSize / 2.0f)),
+                    static_cast<int>(std::lround(cy - emblemSize / 2.0f)), alphaOf(color), -1);
+        return;
+    }
     // Render white-on-black into a scratch canvas, then use it as a coverage
     // mask, so the cut-outs are transparent over any background.
     int size = static_cast<int>(std::ceil(r * 2)) + 4;
